MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=dawn
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EVALUATOR_MODEL=gpt-6-astra
# Choose a unique password of at least 16 characters; never put it in frontend code.
WORKSPACE_PASSWORD=
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=4000
# Render: set to 1 for the platform proxy; leave 0 for direct local access.
TRUST_PROXY_HOPS=0
NODE_ENV=development
# Optional configured prices (USD per million tokens); blank means cost is unknown.
INPUT_PRICE_PER_MILLION=
OUTPUT_PRICE_PER_MILLION=
